{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Sankalp local server",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "http.server",
        "8080",
        "--bind",
        "127.0.0.1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Serving HTTP on .* port 8080"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
